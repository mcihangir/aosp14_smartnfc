aidl_interface {
    name: "smartnfc.hardware.led",
    srcs: ["smartnfc/hardware/led/*.aidl"],
    local_include_dir: ".",
    unstable: true,
    owner: "EMPA",
    backend: {
        java: { enabled: true, platform_apis: true, sdk_version: "module_current" },
        cpp: { enabled: true },
        ndk: { enabled: true },
    },

    vendor_available: true,
    host_supported: false,
}

<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.qtproject.smartperipheral">
        <!-- Privileged/signature|privileged izinler -->
        <permission name="android.permission.WRITE_SECURE_SETTINGS"/>
        <permission name="android.permission.STATUS_BAR"/>
        <permission name="android.permission.EXPAND_STATUS_BAR"/>
        <permission name="android.permission.SET_TIME"/>
        <permission name="android.permission.SET_TIME_ZONE"/>
        <permission name="android.permission.REBOOT"/>

        <!-- Yönetim tarafı (gerekliyse) -->
        <permission name="android.permission.MANAGE_DEVICE_ADMINS"/>
        <permission name="android.permission.BIND_DEVICE_ADMIN"/>

        <!-- Zorunlu değil ama sorun çıkarmaz -->
        <permission name="android.permission.WRITE_SETTINGS"/>
    </privapp-permissions>
</permissions>

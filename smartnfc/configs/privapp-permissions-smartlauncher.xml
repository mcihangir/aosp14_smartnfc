<?xml version="1.0" encoding="utf-8"?>
<permissions>
    <privapp-permissions package="org.qtproject.smartlauncher">

        <!-- Core Permissions -->
        <permission name="android.permission.WAKE_LOCK" />
        <permission name="android.permission.DISPATCH_PROVISIONING_MESSAGE" />
        <permission name="android.permission.STATUS_BAR" />
        <permission name="android.permission.EXPAND_STATUS_BAR" />
        <permission name="android.permission.REBOOT" />

        <!-- Device Owner / Admin Permissions -->
        <permission name="android.permission.BIND_DEVICE_ADMIN" />
        <permission name="android.permission.MANAGE_DEVICE_ADMINS" />
        <permission name="android.permission.WRITE_SECURE_SETTINGS" />
        <permission name="android.permission.WRITE_SETTINGS" />
        <permission name="android.permission.QUERY_ALL_PACKAGES" />

        <!-- Optional: System-level -->
        <permission name="android.permission.SYSTEM_ALERT_WINDOW" />
        <permission name="android.permission.SET_TIME" />
        <permission name="android.permission.SET_TIME_ZONE" />
        <permission name="android.permission.RECEIVE_BOOT_COMPLETED" />
        <permission name="android.permission.ACCESS_WIFI_STATE" />
        <permission name="android.permission.ACCESS_NETWORK_STATE" />
        <permission name="android.permission.CHANGE_WIFI_STATE" />
        <permission name="android.permission.ACCESS_FINE_LOCATION" />
        <permission name="android.permission.ACCESS_COARSE_LOCATION" />
        <permission name="android.permission.LOCAL_MAC_ADDRESS" />
        <permission name="android.permission.NETWORK_SETTINGS" />
        <permission name="android.permission.NETWORK_SETUP_WIZARD" />
        <permission name="android.permission.INTERNET" />
        <permission name="android.permission.REQUEST_WIFI_LOCK" />

        <!-- Audio Permission -->        
        <permission name="android.permission.MODIFY_AUDIO_SETTINGS"/>
        <permission name="android.permission.RECORD_AUDIO"/>

    </privapp-permissions>
</permissions>
